@baseUrl = http://localhost:3000

### Listar todos os projetos
GET {{baseUrl}}/projetos/

### Listar apenas um projeto
GET {{baseUrl}}/projetos/25

### Criar um projeto
POST {{baseUrl}}/projetos/
Content-Type: application/json

{
    "nome": "Projeto para ser atualizado"
    ,"criadoPorId": 1
    ,"categoria": "RPA"
    ,"dataInicio": "2026-12-31"
    ,"dataTermino": "2027-12-31"
    ,"dataTermino": "2027-12-31"
    ,"orcamento": "1000,00"
    ,"prioridade": true
    ,"tarefas": [
        {
            "ordem": 1,
            "nome": "1 Tarefa de projeto de prioridade",
            "concluido": false
        },
        {
            "ordem": 2,
            "nome": "2 Tarefa de projeto de prioridade",
            "concluido": true
        },
        {
            "ordem": 3,
            "nome": "3 Tarefa de projeto de prioridade",
            "concluido": false
        }
    ]
}
### Atualizar um projeto
PATCH {{baseUrl}}/projetos/156
Content-Type: application/json

{
    "nome": "10000 PROJETO COM NOME ATUALIZADO",
    "orcamento": "555,00",
    "tarefas": [
        {
            "id": 323,
            "nome": "NOVA Tarefa de projeto de prioridade",
            "ordem": 2
        }
    ]
}
### Apagar um projeto
DELETE {{baseUrl}}/projetos/146





